# Copia este archivo como .env y ajusta los valores reales.
# NUNCA subas el archivo .env real a un repositorio.

PORT=4000

# Base de datos (MySQL Workbench / servidor local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=municipalidad_sanpablojocopilas

# Entorno: en el servidor real usa NODE_ENV=production
NODE_ENV=development

# Sesiones. En producción es OBLIGATORIO cambiarlo (mínimo 32 caracteres).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia_este_valor_por_una_cadena_larga_y_aleatoria

# CORS: origen del frontend (Next.js). En producción, tu dominio con https,
# por ejemplo: https://munisanpablojocopilas.gob.gt
FRONTEND_ORIGIN=http://localhost:3000

# Límite de intentos fallidos de login (sección 8)
MAX_INTENTOS_FALLIDOS=5
BLOQUEO_MINUTOS=15
